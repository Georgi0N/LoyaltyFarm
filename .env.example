# ------------------------------------------------------------------
# Hasad Loyalty — environment configuration.
# Copy to `.env` and fill with STRONG, UNIQUE values. NEVER commit `.env`.
# In production (APP_ENV=production) the server REFUSES to start unless every
# secret below is set to a value of at least 16 characters.
# ------------------------------------------------------------------

# Environment: development | production
APP_ENV=development
# Public base URL (used for building printed QR scan links, emails, etc.)
APP_URL=http://localhost:3000
PORT=3000

# ---- Database ----
# This build ships with SQLite (file: data/app.db). DATABASE_URL is reserved for
# a future PostgreSQL driver (recommended for high-availability / multi-process).
DATABASE_URL=

# ---- Secrets (generate each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
SESSION_SECRET=change-me-min-16-chars
QR_HMAC_SECRET=change-me-min-16-chars          # HMAC key for hashing product QR tokens
OTP_HMAC_SECRET=change-me-min-16-chars         # HMAC key for hashing OTP codes
REDEMPTION_HMAC_SECRET=change-me-min-16-chars  # HMAC key for hashing redemption tokens

# ---- Cookies / proxy ----
COOKIE_SECURE=false            # MUST be true in production (behind HTTPS)
TRUST_PROXY=1                  # number of proxies in front of the app (correct client IPs)

# ---- OTP / notifications ----
# Delivery: 'console' (dev, prints code to server log) or 'sms' (wire a provider in src/otp.js).
OTP_DELIVERY=console
OTP_DEV_ECHO=true              # echo OTP to the dev client for testing; MUST be false in production
OTP_PROVIDER=                  # e.g. twilio | unifonic | zain-sms  (production)
OTP_API_KEY=                   # provider API key (production; keep out of source control)
WHATSAPP_API_KEY=              # optional: WhatsApp Business API key for notifications
EMAIL_PROVIDER=                # optional: email provider for staff password-reset links

# ---- Password-reset email (SMTP) ----
# If unset, reset links are logged to the server console (dev). Set these to send
# real email (works with any SMTP: Gmail app-password, SendGrid, Resend, Mailgun, SES).
EMAIL_FROM=Hasad <no-reply@yourdomain>
SMTP_HOST=                     # e.g. smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false             # true for port 465

# ---- Portal access (each portal is reached its own way) ----
# Customer app is at '/'. Partners at PARTNER_PATH. Admin at the unguessable
# ADMIN_PATH, optionally behind a shared ADMIN_ACCESS_CODE gate.
PARTNER_PATH=/partner
ADMIN_PATH=/admin-console      # change to something unguessable in production
ADMIN_ACCESS_CODE=             # optional shared code to even reach the admin login
